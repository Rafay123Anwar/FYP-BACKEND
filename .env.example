# ==============================================================================
# AI ATS Backend Environment Variables Template
# Copy this file to .env and provide your actual secrets.
# DO NOT commit the .env file to version control.
# ==============================================================================

# Application
PROJECT_NAME="AI ATS"

# Supabase Cloud Storage & Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# PostgreSQL Connection (supports postgresql:// or postgresql+asyncpg://)
# Example: postgresql+asyncpg://postgres:password@localhost:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@your_db_host:5432/postgres

# JWT Security
SECRET_KEY=your_random_64_char_secure_hex_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cohere AI Resume Intelligence API
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-a-plus-05-2026
